# AWJ Store — Storefront Environment
# ==================================
# This storefront is adapted from Spree Storefront to consume AWJ Commerce APIs.
# The Spree Rails backend is NOT used.

# ---------------------------------------------------------------------------
# AWJ Commerce API (server-side only — never exposed to browser)
# ---------------------------------------------------------------------------
# COM-7-P2B: the read-only catalog (products/categories/media/config) is
# served by the AWJ Laravel backend's public storefront API (store/v1),
# consumed through src/lib/commerce/*. Tenant/Storefront/SalesChannel
# identity is resolved from the visitor's real Host header (COM-7-P2A's
# ResolveStorefrontDomain) — never from a client-supplied header, cookie,
# query parameter, or locale. See
# docs/plans/store/AWJ_COM_7_P2_STOREFRONT_DOMAIN_RESOLUTION_DECISION.md.
AWJ_COMMERCE_API_URL=http://localhost:8000

# This Next.js server, not the browser, is the sole caller of store/v1 in
# production, so Laravel's own $request->getHost() would only ever see this
# server's own domain. STOREFRONT_GATEWAY_SECRET lets Laravel trust an
# explicit forwarded-host header carrying the visitor's real hostname
# instead — must match the backend's own STOREFRONT_GATEWAY_SECRET exactly.
# Never exposed to the browser. Leave empty to disable (falls back to
# Laravel's normal Host-based resolution, which only works when this server
# and Laravel share a literal Host — never true across a real deployment).
STOREFRONT_GATEWAY_SECRET=

# Non-production-only override of the resolved visitor hostname, for local
# development without a real DNS/StorefrontDomain record pointing at this
# machine. Mirrors the backend's own non-production-only {tenantSlug} route.
# NEVER read when NODE_ENV=production — leave empty outside local dev.
AWJ_STOREFRONT_DEV_HOST=

# ---------------------------------------------------------------------------
# Legacy Spree integration — REMOVED
#
# No Spree backend exists in any AWJ environment and the Spree SDK/client code
# has been removed from this storefront (docs/audits/AWJ_H6_FINAL_SPREE_EXIT_REPORT.md).
# SPREE_API_URL / SPREE_PUBLISHABLE_KEY / SPREE_IMAGES_URL / SPREE_WHOLESALE_*
# are no longer read by anything; do not set them. The one retained external
# contract is the inbound webhook route (see the "Transactional emails" block).
# Buyer authentication is gated (`ACCOUNT_AUTH_CAPABILITY` in
# src/lib/commerce/capabilities.ts) until the AWJ buyer-identity contract
# exists. Guest cart, checkout and payment run entirely on AWJ_COMMERCE_API_URL.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Store defaults
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_COUNTRY=sa
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_STORE_NAME=AWJ Store
NEXT_PUBLIC_STORE_DESCRIPTION=متجر أَوْج الإلكتروني

# Store SEO (optional)
STORE_SEO_TITLE=
STORE_META_DESCRIPTION=
STORE_META_KEYWORDS=

# Store social / Organization JSON-LD (optional)
STORE_TWITTER=
STORE_FACEBOOK=
STORE_INSTAGRAM=
STORE_LOGO_URL=
STORE_SUPPORT_EMAIL=

# Google Tag Manager (leave empty to disable)
GTM_ID=

# ---------------------------------------------------------------------------
# Transactional emails (none are sent today — the only sender is driven by the
# inbound /api/webhooks/spree route, retained pending an owner decision (D-14);
# it answers 503 while SPREE_WEBHOOK_SECRET is unset. Do not set it to "enable"
# anything: AWJ emits no such events.)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
