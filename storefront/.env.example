# AWJ Store — Storefront Environment
# ==================================
# This storefront is adapted from Spree Storefront to consume AWJ Commerce APIs.
# The Spree Rails backend is NOT used.

# ---------------------------------------------------------------------------
# AWJ Commerce API (server-side only — never exposed to browser)
# ---------------------------------------------------------------------------
# COM-7-P1: the read-only catalog (products/categories/media) is served by
# the AWJ Laravel backend's public storefront API (store/v1), consumed
# through src/lib/commerce/*. AWJ_STORE_TENANT_SLUG is a PROVISIONAL,
# single-tenant-per-deployment fallback — COM-7-P1 does not implement real
# hostname/domain-based multi-tenant resolution (that is COM-7-P2). It is
# a fixed server-only value, never derived from any client-supplied
# header/cookie/query param. See
# docs/plans/store/AWJ_STOREFRONT_PLACEMENT_TENANT_RESOLUTION_DECISION.md.
AWJ_COMMERCE_API_URL=http://localhost:8000
AWJ_STORE_TENANT_SLUG=

# Cart/checkout/customer auth/wholesale still use the Spree SDK client
# (unchanged from COM-7-P0) — replacing them is later COM-7 phases, not P1.
SPREE_API_URL=http://localhost:8000
SPREE_PUBLISHABLE_KEY=placeholder

# ---------------------------------------------------------------------------
# Store defaults
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_COUNTRY=sa
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_STORE_NAME=AWJ Store
NEXT_PUBLIC_STORE_DESCRIPTION=متجر أَوْج الإلكتروني

# Store SEO (optional)
STORE_SEO_TITLE=
STORE_META_DESCRIPTION=
STORE_META_KEYWORDS=

# Store social / Organization JSON-LD (optional)
STORE_TWITTER=
STORE_FACEBOOK=
STORE_INSTAGRAM=
STORE_LOGO_URL=
STORE_SUPPORT_EMAIL=

# Google Tag Manager (leave empty to disable)
GTM_ID=

# ---------------------------------------------------------------------------
# Transactional emails (disabled in P0 — no Spree webhook contract)
# ---------------------------------------------------------------------------
SPREE_WEBHOOK_SECRET=disabled
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Payment gateways (disabled in P0 — no payment integration yet)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
