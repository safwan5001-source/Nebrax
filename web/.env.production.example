# ════════════════════════════════════════════════════════════════
#  متغيّرات بيئة الإنتاج للواجهة (Next.js) — تُضبط في Vercel
#  Project → Settings → Environment Variables (وليس من هذا الملف)
# ════════════════════════════════════════════════════════════════

# عنوان الـ REST API للـ backend (Laravel) — مستضاف خارج Vercel.
# يجب أن ينتهي بـ /api ، مثال:
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# الواجهة الافتراضية: AWJ Design System v3 (design-system/v3/MIGRATION.md §6، §9).
# "3" = v3 لكل متصفح لم يختر صراحةً؛ غيابه أو أي قيمة أخرى = الواجهة القديمة.
# يُدمج وقت البناء ← يلزم Redeploy. التراجع: احذف المتغيّر ثم Redeploy (إعداد فقط، لا شيفرة).
# الاختيار الصريح يسبق هذا الافتراض دائماً: ?awj-ui=legacy / ?awj-ui=3 (يُحفظ في awj:ui-version).
NEXT_PUBLIC_AWJ_UI_DEFAULT=3
