{
  "_note": "CUST-HV V7a — structural header design (header.design). Shared by PHP StorefrontHeaderDesignNormalizer and both TS twins. `input` is the raw `header.design` value; `expected` is the normalised object, or null when nothing survives (the key is then absent from the document).",
  "cases": [
    { "name": "absent", "input": null, "expected": null },
    { "name": "non-object is ignored", "input": "compact", "expected": null },
    { "name": "a list is not an object", "input": ["compact"], "expected": null },
    { "name": "empty object drops", "input": {}, "expected": null },
    {
      "name": "every field, canonical order",
      "input": { "shadow": "soft", "border": { "width": "medium" }, "sticky": "off", "logo": { "size": "xl" }, "height": "tall", "mobileLayout": "logo-start", "layout": "two-row" },
      "expected": { "layout": "two-row", "mobileLayout": "logo-start", "height": "tall", "logo": { "size": "xl" }, "sticky": "off", "border": { "width": "medium" }, "shadow": "soft" }
    },
    {
      "name": "an invalid value is dropped on its own",
      "input": { "layout": "mega", "mobileLayout": "logo-start", "height": "huge", "sticky": "always", "shadow": "strong" },
      "expected": { "mobileLayout": "logo-start", "sticky": "always" }
    },
    {
      "name": "deferred vocabulary fails closed",
      "input": { "sticky": "sticky-bottom", "mode": "transparent", "search": "icon-expand", "categoryNav": "tabs", "surface": { "background": "#000" }, "logo": { "align": "center", "treatment": "mono-light" } },
      "expected": null
    },
    {
      "name": "nested groups need their own valid field",
      "input": { "logo": { "size": "xxl" }, "border": { "width": "thick", "color": "#fff" } },
      "expected": null
    },
    {
      "name": "non-object nested groups are ignored",
      "input": { "logo": "lg", "border": ["none"], "layout": "centered" },
      "expected": { "layout": "centered" }
    },
    {
      "name": "non-string values never coerce",
      "input": { "layout": 1, "height": true, "shadow": { "x": 1 }, "sticky": ["off"] },
      "expected": null
    },
    {
      "name": "none border is a real choice",
      "input": { "border": { "width": "none" }, "shadow": "none" },
      "expected": { "border": { "width": "none" }, "shadow": "none" }
    },
    {"name": "colours: a role background, hex text and icon, canonical order", "input": {"shadow": "soft", "icon": {"hex": "#FFFFFF"}, "text": {"role": "surface"}, "surface": {"background": {"role": "brand"}}, "layout": "centered"}, "expected": {"layout": "centered", "surface": {"background": {"role": "brand"}}, "text": {"role": "surface"}, "icon": {"hex": "#ffffff"}, "shadow": "soft"}},
    {"name": "colours: a role wins over a hex, a hex is lower-cased", "input": {"text": {"role": "text", "hex": "#123456"}, "icon": {"hex": "#ABCDEF"}}, "expected": {"text": {"role": "text"}, "icon": {"hex": "#abcdef"}}},
    {"name": "colours: invalid references drop on their own", "input": {"surface": {"background": {"hex": "red"}}, "text": {"role": "neon"}, "icon": "#fff", "sticky": "off"}, "expected": {"sticky": "off"}},
    {"name": "colours: only the background is accepted inside surface (alpha and gradient wait for V7c)", "input": {"surface": {"alpha": 50, "background": {"kind": "gradient"}, "text": {"hex": "#000000"}}}, "expected": null},
    {"name": "colours: non-object surface is ignored", "input": {"surface": "#000000", "text": {"hex": "#111111"}}, "expected": {"text": {"hex": "#111111"}}},
    {"name": "sticky: on-scroll-up is a valid choice (V7c-1)", "input": {"sticky": "on-scroll-up", "height": "compact"}, "expected": {"height": "compact", "sticky": "on-scroll-up"}},
    {"name": "mode: overlay-hero and solid are the only modes (V7c-2); transparent stays rejected", "input": {"mode": "overlay-hero", "sticky": "off"}, "expected": {"mode": "overlay-hero", "sticky": "off"}},
    {"name": "mode: solid is a real choice", "input": {"mode": "solid"}, "expected": {"mode": "solid"}},
    {"name": "mode: transparent is dropped on its own", "input": {"mode": "transparent", "shadow": "soft"}, "expected": {"shadow": "soft"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: dark is kept with overlay-hero, canonical order (mode, overlayTone, sticky)", "input": {"sticky": "off", "overlayTone": "dark", "mode": "overlay-hero"}, "expected": {"mode": "overlay-hero", "overlayTone": "dark", "sticky": "off"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: light is kept with overlay-hero", "input": {"mode": "overlay-hero", "overlayTone": "light"}, "expected": {"mode": "overlay-hero", "overlayTone": "light"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: without overlay-hero the tone is inert and dropped (solid mode)", "input": {"mode": "solid", "overlayTone": "dark", "shadow": "soft"}, "expected": {"mode": "solid", "shadow": "soft"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: no mode at all drops the tone", "input": {"overlayTone": "light", "shadow": "soft"}, "expected": {"shadow": "soft"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: an invalid tone (auto) is dropped on its own", "input": {"mode": "overlay-hero", "overlayTone": "auto"}, "expected": {"mode": "overlay-hero"}},
    {"name": "AWJ-HEADER-OVERLAY-TONE: a colour object or non-string tone is dropped", "input": {"mode": "overlay-hero", "overlayTone": {"hex": "#ffffff"}}, "expected": {"mode": "overlay-hero"}}
  ]
}
