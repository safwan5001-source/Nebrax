        },
        {
            "name": "css strings never survive",
            "type": "hero",
            "input": {
                "background": "url(javascript:alert(1))",
                "text": {
                    "heading": "red"
                },
                "style": "position:absolute",
                "className": "x"
            },
            "expected": null
        },
        {
            "name": "role wins over hex when both are present",
            "type": "hero",
            "input": {
                "background": {
                    "kind": "solid",
                    "color": {
                        "role": "accent",
                        "hex": "#ffffff"
                    }
                }
            },
            "expected": {
                "background": {
                    "kind": "solid",
                    "color": {
                        "role": "accent"
                    }
                }
            }
        },
        {
            "name": "hex is canonical lower-case, trimmed",
            "type": "hero",
            "input": {
                "background": {
                    "kind": "solid",
                    "color": {
                        "hex": "  #ABCDEF "
                    }
                }
            },
            "expected": {
                "background": {
                    "kind": "solid",
                    "color": {
                        "hex": "#abcdef"
                    }
                }
            }
        },
        {
            "name": "an unknown role and an unsafe hex are dropped",
            "type": "hero",
            "input": {
                "background": {
                    "kind": "solid",
                    "color": {
                        "role": "primary"
                    }
                },
                "text": {
                    "heading": {
                        "hex": "#fff"
                    },
                    "body": {
                        "role": "text"
                    }
                }
            },
            "expected": {
                "text": {
                    "body": {
                        "role": "text"
                    }
                }
            }
        },
        {
            "name": "invalid values drop on their own",
            "type": "hero",
            "input": {
                "spacing": {
                    "top": "huge",
                    "bottom": "lg",
                    "inner": 7
                },
                "align": "justify",
                "radius": "pill",
                "shadow": "glow"
            },
            "expected": {
                "spacing": {
                    "bottom": "lg"
                },
                "radius": "pill"
            }
        },
        {
            "name": "heading weight must be a real weight",
            "type": "hero",
            "input": {
                "typography": {
                    "headingWeight": "700",
                    "headingScale": "xxl",
                    "lineHeight": "tight"
                }
            },
            "expected": {
                "typography": {
                    "lineHeight": "tight"
                }
            }
        },
        {
            "name": "an integral float weight is accepted",
            "type": "hero",
            "input": {
                "typography": {
                    "headingWeight": 800
                }
            },
            "expected": {
                "typography": {
                    "headingWeight": 800
                }
            }
        },
        {
            "name": "border none carries no colour",
            "type": "hero",
            "input": {
                "border": {
                    "width": "none",
                    "color": {
                        "role": "border"
                    }
                }
            },
            "expected": {
                "border": {
                    "width": "none"
                }
            }
        },
        {
            "name": "border needs a valid width",
            "type": "hero",
            "input": {
                "border": {
                    "width": "thick",
                    "color": {
                        "role": "border"
                    }
                }
            },
            "expected": null
        },
        {
            "name": "explicit none values are meaningful and kept",
            "type": "hero",
            "input": {
                "spacing": {
                    "top": "none",
                    "bottom": "none"
                },
                "radius": "none",
                "shadow": "none"
            },
            "expected": {
                "spacing": {
                    "top": "none",
                    "bottom": "none"
                },
                "radius": "none",
                "shadow": "none"
            }
        },
        {
            "name": "separator overlap motion layout are not accepted yet",
            "type": "hero",
            "input": {
                "separator": {
                    "top": "wave"
                },
                "overlap": "sm",
                "motion": {
                    "reveal": "fade-up"
                },
                "layout": "split",
                "mediaTreatment": {
                    "aspect": "16:9"
                },
                "radius": "sm"
            },
            "expected": {
                "radius": "sm"
            }
        }
    ]
