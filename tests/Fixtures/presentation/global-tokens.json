{
  "_note": "CUST-HV V5e-2a — document-level global tokens (typography / buttons / surfaces / layout / motion). Shared by PHP StorefrontGlobalTokensNormalizer and both TS twins. `input` is the raw document subset; `expected` is exactly the normalised keys that survive (an empty object = none of the four keys are present).",
  "cases": [
    { "name": "absent", "input": {}, "expected": {} },
    { "name": "non-object groups are ignored", "input": { "typography": "lg", "surfaces": ["soft"], "layout": 3, "motion": null }, "expected": {} },
    { "name": "empty groups are dropped", "input": { "typography": {}, "surfaces": {}, "layout": {}, "motion": {} }, "expected": {} },
    {
      "name": "every typography field, canonical order",
      "input": { "typography": { "sectionHeading": "underline", "lineHeight": "relaxed", "bodyWeight": 500, "headingWeight": 800, "bodyScale": "lg", "headingScale": "sm" } },
      "expected": { "typography": { "headingScale": "sm", "bodyScale": "lg", "headingWeight": 800, "bodyWeight": 500, "lineHeight": "relaxed", "sectionHeading": "underline" } }
    },
    {
      "name": "an invalid typography value is dropped on its own",
      "input": { "typography": { "headingScale": "xl", "bodyScale": "md", "headingWeight": 600, "bodyWeight": 800, "lineHeight": "loose", "sectionHeading": "bar" } },
      "expected": { "typography": { "bodyScale": "md", "sectionHeading": "bar" } }
    },
    {
      "name": "weights must be real numbers, never strings",
      "input": { "typography": { "headingWeight": "700", "bodyWeight": "400" } },
      "expected": {}
    },
    {
      "name": "font families: catalogue keys only, canonical order after sectionHeading",
      "input": { "typography": { "bodyFamily": "readex", "headingFamily": "amiri-lora", "headingScale": "lg" } },
      "expected": { "typography": { "headingScale": "lg", "headingFamily": "amiri-lora", "bodyFamily": "readex" } }
    },
    {
      "name": "every catalogue key is accepted for both slots (the first two are the legacy fontPreset values)",
      "input": { "typography": { "headingFamily": "cairo-geist", "bodyFamily": "tajawal-geist" } },
      "expected": { "typography": { "headingFamily": "cairo-geist", "bodyFamily": "tajawal-geist" } }
    },
    {
      "name": "font families: a family name, a CSS stack, a custom upload or a non-string is never a key",
      "input": { "typography": { "headingFamily": "Cairo", "bodyFamily": "custom:0a1b2c3d" } },
      "expected": {}
    },
    {
      "name": "font families: CSS never survives",
      "input": { "typography": { "headingFamily": "readex; background:red", "bodyFamily": "url(x)" } },
      "expected": {}
    },
    {
      "name": "font families: a list or an object is not a key",
      "input": { "typography": { "headingFamily": ["readex"], "bodyFamily": { "key": "readex" }, "lineHeight": "tight" } },
      "expected": { "typography": { "lineHeight": "tight" } }
    },
    {
      "name": "button text: weight and case, canonical order, after the other typography fields",
      "input": { "typography": { "buttonText": { "case": "upper", "weight": 800 }, "lineHeight": "tight" } },
      "expected": { "typography": { "lineHeight": "tight", "buttonText": { "weight": 800, "case": "upper" } } }
    },
    {
      "name": "button text alone creates the typography group",
      "input": { "typography": { "buttonText": { "weight": 500 } } },
      "expected": { "typography": { "buttonText": { "weight": 500 } } }
    },
    {
      "name": "button text: invalid weight/case are dropped on their own; strings and lists are not objects",
      "input": { "typography": { "buttonText": { "weight": 600, "case": "lower" } } },
      "expected": {}
    },
    {
      "name": "button text must be an object",
      "input": { "typography": { "buttonText": "upper", "headingWeight": 700 } },
      "expected": { "typography": { "headingWeight": 700 } }
    },
    {
      "name": "buttons: every field, canonical order",
      "input": { "buttons": { "hover": "lift", "colour": "accent", "radius": "pill", "size": "lg", "style": "outline" } },
      "expected": { "buttons": { "style": "outline", "size": "lg", "radius": "pill", "colour": "accent", "hover": "lift" } }
    },
    {
      "name": "buttons: invalid values are dropped on their own",
      "input": { "buttons": { "style": "ghost", "size": "md", "radius": "round", "colour": "text", "hover": "glow" } },
      "expected": { "buttons": { "size": "md", "colour": "text" } }
    },
    {
      "name": "buttons: colours are palette roles only — never a hex or CSS",
      "input": { "buttons": { "colour": "#ff0000" } },
      "expected": {}
    },
    {
      "name": "buttons: an icon and per-state overrides are not accepted",
      "input": { "buttons": { "icon": { "key": "cart", "placement": "start" }, "style": "soft" } },
      "expected": { "buttons": { "style": "soft" } }
    },
    {
      "name": "surfaces: radius, border width and shadow, canonical order",
      "input": { "surfaces": { "shadow": "medium", "border": { "width": "medium" }, "radius": "pill" } },
      "expected": { "surfaces": { "radius": "pill", "border": { "width": "medium" }, "shadow": "medium" } }
    },
    {
      "name": "surfaces: a border colour is not accepted yet",
      "input": { "surfaces": { "border": { "width": "hairline", "color": { "hex": "#ff0000" } } } },
      "expected": { "surfaces": { "border": { "width": "hairline" } } }
    },
    {
      "name": "surfaces: border must be an object with a valid width",
      "input": { "surfaces": { "border": "medium", "radius": "sm" } },
      "expected": { "surfaces": { "radius": "sm" } }
    },
    {
      "name": "surfaces: unknown values never survive",
      "input": { "surfaces": { "radius": "huge", "shadow": "glow", "border": { "width": "thick" } } },
      "expected": {}
    },
    {
      "name": "layout content width",
      "input": { "layout": { "contentWidth": "wide", "other": "x" } },
      "expected": { "layout": { "contentWidth": "wide" } }
    },
    {
      "name": "layout content width: arbitrary lengths are rejected",
      "input": { "layout": { "contentWidth": "120rem" } },
      "expected": {}
    },
    {
      "name": "motion duration and easing",
      "input": { "motion": { "easing": "emphasized", "duration": "slow" } },
      "expected": { "motion": { "duration": "slow", "easing": "emphasized" } }
    },
    {
      "name": "motion: arbitrary durations/keyframes are rejected",
      "input": { "motion": { "duration": "2000ms", "easing": "cubic-bezier(0,0,0,0)", "keyframes": "x" } },
      "expected": {}
    },
    {
      "name": "all five groups together keep a fixed key order",
      "input": { "motion": { "duration": "fast" }, "layout": { "contentWidth": "narrow" }, "buttons": { "style": "soft" }, "surfaces": { "radius": "none" }, "typography": { "lineHeight": "tight" } },
      "expected": { "typography": { "lineHeight": "tight" }, "buttons": { "style": "soft" }, "surfaces": { "radius": "none" }, "layout": { "contentWidth": "narrow" }, "motion": { "duration": "fast" } }
    },
    {
      "name": "css strings and injected content never survive",
      "input": { "typography": { "headingScale": "lg; background:red", "lineHeight": "url(javascript:alert(1))" }, "surfaces": { "radius": "0.75rem" } },
      "expected": {}
    }
  ]
}
