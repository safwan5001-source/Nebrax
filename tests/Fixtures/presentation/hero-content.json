                    {
                        "label": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
                        "href": "/a"
                    }
                ]
            },
            "expected": {
                "headline": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
                "subheadline": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
                "ctas": [
                    {
                        "label": "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀",
                        "href": "/a"
                    }
                ]
            }
        },
        {
            "name": "hero: unknown and banner-only keys never survive",
            "type": "hero",
            "input": {
                "headline": "H",
                "title": "T",
                "ctaLabel": "L",
                "ctaHref": "/x",
                "imageUrl": "https://example.com/i.png",
                "media": {
                    "mediaId": "m"
                }
            },
            "expected": {
                "headline": "H"
            }
        },
        {
            "name": "hero: a non-string headline with nothing else is not explicit content",
            "type": "hero",
            "input": {
                "headline": 123
            },
            "expected": null
        },
        {
            "name": "hero: a non-string headline next to valid CTAs keeps an empty headline",
            "type": "hero",
            "input": {
                "headline": 123,
                "ctas": [
                    {
                        "label": "Go",
                        "href": "/go"
                    }
                ]
            },
            "expected": {
                "headline": "",
                "ctas": [
                    {
                        "label": "Go",
                        "href": "/go"
                    }
                ]
            }
        },
        {
            "name": "hero: a plain object with nothing recognisable is absent content",
            "type": "hero",
            "input": {
                "unrelated": true
            },
            "expected": null
        },
        {
            "name": "hero: a string is not content",
            "type": "hero",
            "input": "headline",
            "expected": null
        },
        {
            "name": "hero: a list is not content",
            "type": "hero",
            "input": [
                {
                    "headline": "H"
                }
            ],
            "expected": null
        },
        {
            "name": "hero: null is not content",
            "type": "hero",
            "input": null,
            "expected": null
        },
        {
            "name": "hero: ctas that is not a list is ignored",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": {
                    "label": "A",
                    "href": "/a"
                }
            },
            "expected": {
                "headline": "H"
            }
        },
        {
            "name": "hero: a trailing space survives (the editor re-normalizes on every keystroke, so a space between two words must not be swallowed)",
            "type": "hero",
            "input": {
                "headline": "Summer ",
                "subheadline": "Fresh ",
                "ctas": [
                    {
                        "label": "Shop ",
                        "href": "/shop"
                    }
                ]
            },
            "expected": {
                "headline": "Summer ",
                "subheadline": "Fresh ",
                "ctas": [
                    {
                        "label": "Shop ",
                        "href": "/shop"
                    }
                ]
            }
        },
        {
            "name": "hero V6c-5: per-CTA style is kept in canonical order; an unknown style / colour / icon is dropped",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {
                        "style": "link",
                        "href": "/a",
                        "label": "A",
                        "colour": "accent"
                    },
                    {
                        "label": "B",
                        "href": "/b",
                        "style": "soft",
                        "icon": {
                            "key": "arrow"
                        }
                    }
                ]
            },
            "expected": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "A",
                        "href": "/a",
                        "style": "link"
                    },
                    {
                        "label": "B",
                        "href": "/b"
                    }
                ]
            }
        },
        {
            "name": "hero V6c-5: a style alone is not a button",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {
                        "style": "solid"
                    }
                ]
            },
            "expected": {
                "headline": "H"
            }
        }
