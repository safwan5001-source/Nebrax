{
    "_note": "CUST-HV V6a — per-instance hero content (V0 §8.2). Shared by PHP StorefrontPresentationNormalizer and both TS section-content twins. expected=null means the content key is absent (hero then reads the legacy homepage.heroHeadline/heroSubheadline).",
    "cases": [
        {
            "name": "hero: every field, canonical order (headline, subheadline, ctas); text is kept as written, links are trimmed",
            "type": "hero",
            "input": {
                "ctas": [
                    {
                        "href": " /collections/new ",
                        "label": " Shop new "
                    },
                    {
                        "label": "Our story",
                        "href": "https://example.com/about"
                    }
                ],
                "subheadline": "  Fresh every day  ",
                "headline": "  Welcome  "
            },
            "expected": {
                "headline": "  Welcome  ",
                "subheadline": "  Fresh every day  ",
                "ctas": [
                    {
                        "label": " Shop new ",
                        "href": "/collections/new"
                    },
                    {
                        "label": "Our story",
                        "href": "https://example.com/about"
                    }
                ]
            }
        },
        {
            "name": "hero: an explicit empty headline is kept (store name + default CTA) — it is NOT the absent legacy case",
            "type": "hero",
            "input": {
                "headline": ""
            },
            "expected": {
                "headline": ""
            }
        },
        {
            "name": "hero: a whitespace-only headline collapses to the explicit empty content",
            "type": "hero",
            "input": {
                "headline": "   "
            },
            "expected": {
                "headline": ""
            }
        },
        {
            "name": "hero: a subheadline alone keeps an empty headline",
            "type": "hero",
            "input": {
                "subheadline": "Only a line"
            },
            "expected": {
                "headline": "",
                "subheadline": "Only a line"
            }
        },
        {
            "name": "hero: CTAs alone keep an empty headline",
            "type": "hero",
            "input": {
                "ctas": [
                    {
                        "label": "Go",
                        "href": "/products"
                    }
                ]
            },
            "expected": {
                "headline": "",
                "ctas": [
                    {
                        "label": "Go",
                        "href": "/products"
                    }
                ]
            }
        },
        {
            "name": "hero: at most two CTAs, in order",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "A",
                        "href": "/a"
                    },
                    {
                        "label": "B",
                        "href": "/b"
                    },
                    {
                        "label": "C",
                        "href": "/c"
                    }
                ]
            },
            "expected": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "A",
                        "href": "/a"
                    },
                    {
                        "label": "B",
                        "href": "/b"
                    }
                ]
            }
        },
        {
            "name": "hero: an incomplete CTA is kept as a draft (label without a link, link without a label) — only a complete one renders",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "Only label"
                    },
                    {
                        "href": "/only-href"
                    }
                ]
            },
            "expected": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "Only label",
                        "href": ""
                    },
                    {
                        "label": "",
                        "href": "/only-href"
                    }
                ]
            }
        },
        {
            "name": "hero: an unsafe href is emptied on its own — the label stays as a draft",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "Bad",
                        "href": "javascript:alert(1)"
                    },
                    {
                        "label": "Proto",
                        "href": "//evil.example"
                    },
                    {
                        "label": "Spaces",
                        "href": "/a b"
                    }
                ]
            },
            "expected": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "Bad",
                        "href": ""
                    },
                    {
                        "label": "Proto",
                        "href": ""
                    }
                ]
            }
        },
        {
            "name": "hero: a wholly empty CTA is dropped and does not consume a slot",
            "type": "hero",
            "input": {
                "headline": "H",
                "ctas": [
                    {},
                    {
                        "label": "",
                        "href": ""
                    },
                    {
                        "label": "A",
                        "href": "/a"
                    },
                    {
                        "label": "B",
                        "href": "/b"
                    },
                    {
                        "label": "C",
                        "href": "/c"
                    }
                ]
            },
            "expected": {
                "headline": "H",
                "ctas": [
                    {
                        "label": "A",
                        "href": "/a"
                    },
                    {
                        "label": "B",
                        "href": "/b"
                    }
                ]
            }
        },
