    {"name":"design: partial spacing keeps the valid side","input":{"design":{"spacing":{"top":"xl","bottom":"md"}}},"expected":{"design":{"spacing":{"bottom":"md"}}}},
    {"name":"design: spacing with no valid side drops","input":{"design":{"spacing":{"top":"huge"}}},"expected":null},
