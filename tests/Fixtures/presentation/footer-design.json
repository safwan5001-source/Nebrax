{
  "_note": "CUST-HV V7e-1 — footer layout / groups / design. Shared by PHP StorefrontFooterNormalizer and both TS twins (normalizeFooterExtras). `input` is the raw `footer` value; `expected` is the object of the keys that survive (layout, groups, design — in that order), or null when none does (the keys are then absent from the document). Legacy fields (tagline, showLogo, copyright) are not part of it.",
  "cases": [
    {"name":"absent","input":null,"expected":null},
    {"name":"non-object","input":"columns","expected":null},
    {"name":"a list is not an object","input":["columns"],"expected":null},
    {"name":"empty footer drops everything","input":[],"expected":null},
    {"name":"legacy fields alone add no key","input":{"tagline":"hi","showLogo":false,"copyright":"c"},"expected":null},
    {"name":"every layout","input":{"layout":"brand-heavy"},"expected":{"layout":"brand-heavy"}},
    {"name":"layout compact","input":{"layout":"compact"},"expected":{"layout":"compact"}},
    {"name":"unknown layout is dropped","input":{"layout":"mega"},"expected":null},
    {"name":"layout is case sensitive","input":{"layout":"Columns"},"expected":null},
    {"name":"one group with a menu reference and links, canonical order","input":{"groups":[{"span":2,"links":[{"id":"a","label":"Privacy","target":{"kind":"content","slug":"privacy-policy"}}],"menu":"footer","title":"Policies","id":"g1"}]},"expected":{"groups":[{"id":"g1","title":"Policies","menu":"footer","links":[{"id":"a","label":"Privacy","target":{"kind":"content","slug":"privacy-policy"},"enabled":true}],"span":2}]}},
    {"name":"a group without a source is kept (a draft)","input":{"groups":[{"id":"g1","title":"Empty"}]},"expected":{"groups":[{"id":"g1","title":"Empty"}]}},
    {"name":"a bad menu id is dropped, the group stays","input":{"groups":[{"id":"g1","title":"T","menu":"not valid!"}]},"expected":{"groups":[{"id":"g1","title":"T"}]}},
    {"name":"span other than 1 or 2 is dropped","input":{"groups":[{"id":"g1","title":"T","span":3},{"id":"g2","title":"U","span":"2"},{"id":"g3","title":"V","span":1}]},"expected":{"groups":[{"id":"g1","title":"T"},{"id":"g2","title":"U"},{"id":"g3","title":"V","span":1}]}},
    {"name":"title is cut at 40, not trimmed","input":{"groups":[{"id":"g1","title":"  0123456789012345678901234567890123456789ABCDEF"}]},"expected":{"groups":[{"id":"g1","title":"  01234567890123456789012345678901234567"}]}},
    {"name":"group ids: bad ids fall back, duplicates are renamed","input":{"groups":[{"id":"x","title":"A"},{"id":"x","title":"B"},{"id":"bad id","title":"C"},{"title":"D"}]},"expected":{"groups":[{"id":"x","title":"A"},{"id":"x-2","title":"B"},{"id":"group-2","title":"C"},{"id":"group-3","title":"D"}]}},
    {"name":"non-object groups are skipped","input":{"groups":["x",3,null,{"id":"ok","title":"OK"}]},"expected":{"groups":[{"id":"ok","title":"OK"}]}},
    {"name":"groups must be a list","input":{"groups":{"a":{"id":"g","title":"T"}}},"expected":null},
    {"name":"at most 6 groups","input":{"groups":[{"id":"g1","title":"1"},{"id":"g2","title":"2"},{"id":"g3","title":"3"},{"id":"g4","title":"4"},{"id":"g5","title":"5"},{"id":"g6","title":"6"},{"id":"g7","title":"7"},{"id":"g8","title":"8"}]},"expected":{"groups":[{"id":"g1","title":"1"},{"id":"g2","title":"2"},{"id":"g3","title":"3"},{"id":"g4","title":"4"},{"id":"g5","title":"5"},{"id":"g6","title":"6"}]}},
    {"name":"links: invalid targets drop, children and header presentation never survive","input":{"groups":[{"id":"g1","title":"T","links":[{"id":"l1","label":"Home","target":{"kind":"home"},"children":[{"id":"c","label":"C","target":{"kind":"home"}}],"presentation":{"kind":"dropdown"}},{"id":"l2","label":"Bad","target":{"kind":"category"}},{"id":"l3","label":"Cat","target":{"kind":"category","id":"c-1"},"icon":"tag","badge":{"text":"New","tone":"accent"},"enabled":false},{"id":"l4","label":"Js","target":{"kind":"external","href":"javascript:alert(1)"}},{"id":"l5","label":"Ext","target":{"kind":"external","href":"https://example.com/x","newTab":true}}]}]},"expected":{"groups":[{"id":"g1","title":"T","links":[{"id":"l1","label":"Home","target":{"kind":"home"},"enabled":true},{"id":"l3","label":"Cat","target":{"kind":"category","id":"c-1"},"enabled":false,"icon":"tag","badge":{"text":"New","tone":"accent"}},{"id":"l5","label":"Ext","target":{"kind":"external","href":"https://example.com/x","newTab":true},"enabled":true}]}]}},
    {"name":"at most 8 links per group","input":{"groups":[{"id":"g1","title":"T","links":[{"id":"1","label":"1","target":{"kind":"home"}},{"id":"2","label":"2","target":{"kind":"home"}},{"id":"3","label":"3","target":{"kind":"home"}},{"id":"4","label":"4","target":{"kind":"home"}},{"id":"5","label":"5","target":{"kind":"home"}},{"id":"6","label":"6","target":{"kind":"home"}},{"id":"7","label":"7","target":{"kind":"home"}},{"id":"8","label":"8","target":{"kind":"home"}},{"id":"9","label":"9","target":{"kind":"home"}}]}]},"expected":{"groups":[{"id":"g1","title":"T","links":[{"id":"1","label":"1","target":{"kind":"home"},"enabled":true},{"id":"2","label":"2","target":{"kind":"home"},"enabled":true},{"id":"3","label":"3","target":{"kind":"home"},"enabled":true},{"id":"4","label":"4","target":{"kind":"home"},"enabled":true},{"id":"5","label":"5","target":{"kind":"home"},"enabled":true},{"id":"6","label":"6","target":{"kind":"home"},"enabled":true},{"id":"7","label":"7","target":{"kind":"home"},"enabled":true},{"id":"8","label":"8","target":{"kind":"home"},"enabled":true}]}]}},
    {"name":"link ids are unique within a group","input":{"groups":[{"id":"g1","title":"T","links":[{"id":"a","label":"1","target":{"kind":"home"}},{"id":"a","label":"2","target":{"kind":"home"}}]}]},"expected":{"groups":[{"id":"g1","title":"T","links":[{"id":"a","label":"1","target":{"kind":"home"},"enabled":true},{"id":"a-2","label":"2","target":{"kind":"home"},"enabled":true}]}]}},
    {"name":"design: every field, canonical order","input":{"design":{"align":"center","logo":{"size":"lg"},"spacing":{"bottom":"sm","top":"lg"},"divider":{"color":{"hex":"#334155"}},"link":{"hex":"#e2e8f0"},"heading":{"hex":"#ffffff"},"text":{"role":"text"},"surface":{"background":{"hex":"#0f172a"}}}},"expected":{"design":{"surface":{"background":{"hex":"#0f172a"}},"text":{"role":"text"},"heading":{"hex":"#ffffff"},"link":{"hex":"#e2e8f0"},"divider":{"color":{"hex":"#334155"}},"spacing":{"top":"lg","bottom":"sm"},"logo":{"size":"lg"},"align":"center"}}},
    {"name":"design: a role background","input":{"design":{"surface":{"background":{"role":"brand"}}}},"expected":{"design":{"surface":{"background":{"role":"brand"}}}}},
