            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [],
                    "zoom": "off"
                }
            }
        },
        {
            "name": "product page: a newer page version fails closed, zoom or not",
            "input": {
                "product": {
                    "version": 2,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                }
            },
            "expected": null
