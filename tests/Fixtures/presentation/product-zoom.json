                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ]
                }
            }
        },
        {
            "name": "product page: zoom is case-sensitive",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
