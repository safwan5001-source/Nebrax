            }
        },
        {
            "name": "both pages: only the product keeps zoom",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                },
                "category": {
                    "version": 1,
                    "regions": [],
                    "zoom": "off"
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                },
                "category": {
                    "version": 1,
                    "regions": []
                }
            }
        },
        {
            "name": "canonical order survives a shuffled input",
            "input": {
                "product": {
                    "zoom": "off",
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "version": 1
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                }
            }
        }
    ]
}
