{
    "_note": "CUST-HV V9e (V0 §14.2) — product page `zoom: on|off`: stored ONLY as \"off\" (absence = on, today). `input` is a raw `pagePresentation`; `expected` the normalised namespace (null = nothing stored). Shared by PHP StorefrontPresentationNormalizer and both TS twins (normalizePagePresentation).",
    "cases": [
        {
            "name": "product page: zoom off is kept after the regions",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "off"
                }
            }
        },
        {
            "name": "product page: zoom on is the absence",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": "on"
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ]
                }
            }
        },
        {
            "name": "product page: zoom absent",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ]
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ]
                }
            }
        },
        {
            "name": "product page: zoom false is not off",
            "input": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ],
                    "zoom": false
                }
            },
            "expected": {
                "product": {
                    "version": 1,
                    "regions": [
                        {
                            "id": "media_gallery",
                            "key": "media_gallery",
                            "visible": true
                        },
                        {
                            "id": "price",
                            "key": "price",
                            "visible": true
                        }
                    ]
                }
            }
        },
