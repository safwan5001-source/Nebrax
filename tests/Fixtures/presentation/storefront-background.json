{
  "cases": [
    {
      "name": "solid role",
      "input": { "kind": "solid", "color": { "role": "surfaceAlt" } },
      "expected": { "kind": "solid", "color": { "role": "surfaceAlt" } }
    },
    {
      "name": "gradient lowercases hex and keeps direction",
      "input": {
        "kind": "gradient",
        "from": { "hex": "#ABCDEF" },
        "to": { "hex": "#123456" },
        "direction": "to-bottom"
      },
      "expected": {
        "kind": "gradient",
        "from": { "hex": "#abcdef" },
        "to": { "hex": "#123456" },
        "direction": "to-bottom"
      }
    },
    {
      "name": "media forces decorative and keeps still ref contract",
      "input": {
        "kind": "media",
        "media": {
          "mediaId": "0B8F6C2E-3D3A-4A53-9C7E-8F1A2B3C4D5E",
          "url": "https://evil.example/background.jpg",
          "src": "https://evil.example/also-evil.jpg",
          "path": "/etc/passwd",
          "style": "background-image: url(https://evil.example)",
          "animation": "spin",
          "video": "https://evil.example/video.mp4",
          "autoplay": true,
          "nested": { "javascript": "alert(1)" }
        },
        "overlay": { "alpha": 40, "style": "opacity: 1" },
        "src": "https://evil.example/top-level.jpg",
        "path": "/tmp/evil",
        "style": "color: red",
        "animation": { "name": "spin" },
        "video": { "autoplay": true }
      },
      "expected": {
        "kind": "media",
        "media": {
          "mediaId": "0b8f6c2e-3d3a-4a53-9c7e-8f1a2b3c4d5e",
          "decorative": true
        },
        "overlay": { "color": { "role": "overlay" }, "alpha": 40 }
      }
    },
    {
      "name": "null explicitly clears the new field",
      "input": null,
      "expected": null
    },
    {
      "name": "unknown kind is invalid",
      "input": { "kind": "video", "src": "https://evil.example/video.mp4" },
      "expected": null
    },
    {
      "name": "invalid solid color is invalid",
      "input": { "kind": "solid", "color": { "hex": "red" } },
      "expected": null
    }
  ]
}
