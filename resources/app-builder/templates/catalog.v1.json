{
  "key": "catalog",
  "version": 1,
  "vertical": "retail",
  "name": {
    "ar": "متجر منتجات",
    "en": "Product store"
  },
  "description": {
    "ar": "رئيسية بقائمة منتجات حيّة من متجرك (الأحدث أولاً) وصفحة للسلة.",
    "en": "A home page with a live product list from your store (newest first) and a cart page."
  },
  "schema": {
    "schemaVersion": "1.0.0",
    "minRuntimeVersion": "1.0.0",
    "navigation": {
      "initialPageId": "home"
    },
    "theme": {
      "tokens": {}
    },
    "pages": {
      "home": {
        "type": "Page",
        "id": "home-root",
        "children": [
          {
            "type": "Section",
            "id": "sec-title",
            "props": {
              "title": "منتجاتنا"
            },
            "children": [
              {
                "type": "ProductList",
                "id": "list-products",
                "binding": {
                  "resource": "commerce.products",
                  "query": {
                    "sort": "-created_at"
                  }
                },
                "children": [
                  {
                    "type": "ProductCard",
                    "id": "card-template",
                    "props": {
                      "title": "$item.name",
                      "amountMinor": "$item.price.amount_minor"
                    },
                    "action": {
                      "type": "openProduct",
                      "params": {
                        "productId": "$item.id"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "Button",
            "id": "btn-cart",
            "props": {
              "label": "عرض السلة",
              "style": "secondary"
            },
            "action": {
              "type": "navigate",
              "params": {
                "pageId": "cart"
              }
            }
          }
        ]
      },
      "cart": {
        "type": "Page",
        "id": "cart-root",
        "children": [
          {
            "type": "CartList",
            "id": "cart-list",
            "children": [
              {
                "type": "CartSummary",
                "id": "cart-summary"
              }
            ]
          }
        ]
      }
    }
  }
}
