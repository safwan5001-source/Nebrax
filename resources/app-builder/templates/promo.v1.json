{
  "key": "promo",
  "version": 1,
  "vertical": "general",
  "name": {
    "ar": "صفحة عرض وترويج",
    "en": "Promo landing"
  },
  "description": {
    "ar": "صفحة ترحيب بعرض وزر تسوّق وقائمة الأكثر مبيعاً.",
    "en": "A welcome page with an offer, a shop button and a best-selling list."
  },
  "schema": {
    "schemaVersion": "1.0.0",
    "minRuntimeVersion": "1.0.0",
    "navigation": {
      "initialPageId": "home"
    },
    "theme": {
      "tokens": {}
    },
    "pages": {
      "home": {
        "type": "Page",
        "id": "home-root",
        "children": [
          {
            "type": "Section",
            "id": "sec-hero",
            "props": {
              "title": "عرض خاص"
            },
            "children": [
              {
                "type": "Text",
                "id": "txt-hero",
                "props": {
                  "text": "اكتشف تشكيلتنا المختارة بعناية.",
                  "style": "title"
                }
              },
              {
                "type": "Button",
                "id": "btn-shop",
                "props": {
                  "label": "تسوّق الآن",
                  "style": "primary"
                },
                "action": {
                  "type": "navigate",
                  "params": {
                    "pageId": "cart"
                  }
                }
              }
            ]
          },
          {
            "type": "Section",
            "id": "sec-best",
            "props": {
              "title": "الأكثر مبيعاً"
            },
            "children": [
              {
                "type": "ProductList",
                "id": "list-best",
                "binding": {
                  "resource": "commerce.products",
                  "query": {
                    "sort": "-popularity"
                  }
                },
                "children": [
                  {
                    "type": "ProductCard",
                    "id": "best-template",
                    "props": {
                      "title": "$item.display_name",
                      "amountMinor": "$item.price.amount_minor"
                    },
                    "action": {
                      "type": "openProduct",
                      "params": {
                        "productId": "$item.id"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "cart": {
        "type": "Page",
        "id": "cart-root",
        "children": [
          {
            "type": "NavigationTarget",
            "id": "go-home",
            "props": {
              "label": "متابعة التسوّق"
            },
            "action": {
              "type": "navigate",
              "params": {
                "pageId": "home"
              }
            }
          },
          {
            "type": "CartList",
            "id": "cart-items",
            "binding": {
              "resource": "commerce.cart",
              "collect": "items"
            },
            "children": [
              {
                "type": "Section",
                "id": "cart-line-template",
                "optional": true,
                "props": {
                  "title": "$item.product_name"
                },
                "children": [
                  {
                    "type": "Text",
                    "id": "cart-line-template-variant",
                    "optional": true,
                    "props": {
                      "text": "$item.variant_descriptor",
                      "style": "caption"
                    }
                  },
                  {
                    "type": "Price",
                    "id": "cart-line-template-price",
                    "optional": true,
                    "props": {
                      "amountMinor": "$item.line_total.amount_minor"
                    }
                  },
                  {
                    "type": "Quantity",
                    "id": "cart-line-template-qty",
                    "optional": true,
                    "props": {
                      "value": "$item.quantity",
                      "min": 1,
                      "max": 99
                    },
                    "action": {
                      "type": "updateCartQuantity",
                      "params": {
                        "cartItemId": "$item.id",
                        "quantity": "$item.quantity"
                      }
                    }
                  },
                  {
                    "type": "Button",
                    "id": "cart-line-template-remove",
                    "optional": true,
                    "props": {
                      "label": "إزالة",
                      "style": "secondary"
                    },
                    "action": {
                      "type": "removeCartItem",
                      "params": {
                        "cartItemId": "$item.id"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "CartSummary",
            "id": "cart-summary",
            "props": {
              "itemCount": 0,
              "subtotalAmountMinor": 0
            }
          }
        ]
      }
    }
  }
}
